# Version Control
.git
.gitignore
.gitattributes

# Node.js
node_modules
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# PHP Vendor (will be copied from composer stage)
vendor

# Storage directories (will be created at runtime)
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/views

# Allow .env file to be copied (created by GitHub Actions workflow)
# Still exclude encrypted .env files and examples
.env.*.encrypted
.env.example
.env.testing
.env.local
.env.backup

# Docker files
docker-compose*.yml
docker/*
!docker/laravel
docker/laravel/*
!docker/laravel/entrypoint.sh
.docker/
Dockerfile*

# IDE and Editor
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# Testing
tests
.phpunit.result.cache
phpunit.xml
coverage

# CI/CD
.github

# Documentation (keep README.md)
*.md
!README.md
docs

# Development tools
.editorconfig
.php_cs
.php_cs.cache
.php-cs-fixer.cache
phpstan.neon
psalm.xml

# Build artifacts
public/hot
public/storage
*.key

# Large files
*.sql
*.dump
*.zip
*.tar.gz
*.bak
*.backup
*.old

# OS files
.DS_Store
Thumbs.db
Desktop.ini