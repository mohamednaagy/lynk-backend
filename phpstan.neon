includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/shipmonk/dead-code-detector/rules.neon

parameters:

    paths:
        - app/
        - config/
        - database/
        - Modules/

    # The level 9 is the highest level
    level: 6

    ignoreErrors:
        - '#Unsafe usage of new static#'

