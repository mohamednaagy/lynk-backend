{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "anhskohbo/no-captcha": "^3.7",
        "bensampo/laravel-enum": "^6.0",
        "bepsvpt/secure-headers": "^7.4",
        "brainmaestro/composer-git-hooks": "^3.0",
        "brick/math": "^0.11.0",
        "cknow/laravel-money": "^8.0",
        "codedredd/laravel-soap": "^4.0",
        "guzzlehttp/guzzle": "^7.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.25",
        "laravel/nightwatch": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mews/purifier": "^3.3",
        "mpdf/mpdf": "^8.0",
        "nwidart/laravel-modules": "^9.0",
        "olssonm/l5-very-basic-auth": "^7.1",
        "php-open-source-saver/jwt-auth": "^2.8",
        "predis/predis": "^2.0",
        "propaganistas/laravel-phone": "^5.0",
        "salla/zatca": "^2.0",
        "shivella/laravel-bitly": "^1.1",
        "spatie/fractalistic": "^2.9",
        "spatie/laravel-activitylog": "^4.6",
        "spatie/laravel-fractal": "^6.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-settings": "^3.0",
        "spatie/laravel-translatable": "^6.5",
        "spatie/laravel-webhook-server": "^3.2",
        "spatie/php-structure-discoverer": "^2.1",
        "stancl/tenancy": "^3.6",
        "stillat/numeral.php": "^2.0",
        "symfony/http-client": "^6.1",
        "symfony/mailgun-mailer": "^6.1",
        "twilio/sdk": "^6.37",
        "web-token/jwt-encryption-algorithm-aescbc": "*",
        "web-token/jwt-encryption-algorithm-dir": "*",
        "web-token/jwt-framework": "^3.4",
        "web-token/jwt-signature-algorithm-hmac": "*"
    },
    "require-dev": {
        "andyabih/laravel-to-uml": "^1.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.9.1",
        "laravel-lang/attributes": "^2.0",
        "laravel-lang/lang": "^12.0",
        "laravel-lang/publisher": "^16.0",
        "laravel/pint": "^1.2",
        "laravel/sail": "^1.0.1",
        "laravel/telescope": "^5.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-webhook-client": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/HelperFunctions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cghooks": "./vendor/bin/cghooks",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "cghooks update"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "cghooks update"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        },
        "hooks": {
            "pre-commit": [
                "echo committing as $(git config user.name)",
                "./vendor/bin/pint $(git diff --name-only --cached --diff-filter=ACMR)",
                "git add $(git diff --name-only --cached --diff-filter=ACMR)"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
